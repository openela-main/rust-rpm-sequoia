%global crate rpm-sequoia

Name:           rust-rpm-sequoia
Version:        1.6.0
Release:        %autorelease
Summary:        Implementation of the RPM PGP interface using Sequoia

License:        LGPL-2.0-or-later
URL:            https://crates.io/crates/rpm-sequoia
Source:         %{crates_source}
